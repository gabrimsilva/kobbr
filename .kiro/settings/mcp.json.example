{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--project-ref=SEU_PROJECT_REF_AQUI"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "SEU_SUPABASE_ACCESS_TOKEN_AQUI"
      },
      "disabled": false,
      "autoApprove": [
        "list_tables",
        "list_extensions",
        "list_migrations",
        "execute_sql"
      ]
    }
  }
}
